{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zWork",
  "version": "0.7.0",
  "identifier": "com.zwork.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "zWork",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 20, "y": 35 },
        "hiddenTitle": true,
        "zoomHotkeysEnabled": true,
        "decorations": true,
        "transparent": true,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "overlay",
        "dragDropEnabled": false,
        "title": "zWork Companion",
        "width": 136,
        "height": 124,
        "transparent": true,
        "shadow": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "share",
        "title": "Share a Window",
        "width": 520,
        "height": 560,
        "minWidth": 420,
        "minHeight": 440,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "center": true,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' http://127.0.0.1:8787 https://api.tryzwork.app https://us.i.posthog.com https://*.posthog.com https://api.github.com; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost https://cdn.jsdelivr.net https://logos.composio.dev data: blob:; font-src 'self' data:; frame-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.13",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    },
    "externalBin": [
      "binaries/zwork-backend"
    ],
    "resources": [
      "binaries/cua-driver*",
      "extension/*",
      "zWork-Skills/**/*",
      "CuaDriver.app/**/*"
    ],
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNjFFODFFMDk0MDEzQzUKUldURkUwQUpIdWhoMGkrSThWeHdseXB1ZTVvWFBCV2MrRXhIU1RJRVZkMm4wR0F0Q3pBR1d0VzcK",
      "endpoints": [
        "https://github.com/Ryz3nPlayZ/zWork/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
