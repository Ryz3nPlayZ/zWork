{
  "manifest_version": 3,
  "name": "zbctl Bridge",
  "version": "0.2.4",
  "description": "Chrome Extension Bridge for zbctl / zWork Desktop Agent",
  "permissions": ["activeTab", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
