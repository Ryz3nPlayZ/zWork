POSTGRES_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=

POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
OWNER_EMAILS=

ROUTER_LABEL=zWork Router
# The router's only upstream. Every hosted tier is an OpenRouter model with
# :floor (cheapest-provider) routing: Flash = gpt-6-luna / glm-5.3-flash /
# deepseek-v4.1-flash, Pro = glm-5.3, Ultra = gemini-3.8-flash, ?????? =
# gpt-6.1-sol. Both request shapes are served:
#   OpenAI:    {OPENROUTER_BASE_URL}/chat/completions
#   Anthropic: {OPENROUTER_ANTHROPIC_BASE_URL}/v1/messages
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ANTHROPIC_BASE_URL=https://openrouter.ai/api

CORS_ALLOWED_ORIGINS=tauri://localhost,https://tauri.localhost,http://tauri.localhost,https://localhost:1420,http://localhost:1420,https://127.0.0.1:1420,http://127.0.0.1:1420,https://tryzwork.app,https://www.tryzwork.app,https://api.tryzwork.app,https://app.tryzwork.app

ZWORK_GATEWAY_TOKEN=
MAX_CONCURRENT_ROOT_RUNS=3
PRO_MAX_CONCURRENT_ROOT_RUNS=10
MAX_MAX_CONCURRENT_ROOT_RUNS=20

# Usage is metered in USD of upstream (OpenRouter) cost.
# Pro ($12/mo) gets $4/mo of API spend; Max ($50/mo) gets a third of its price.
PRO_WEEKLY_USD=0.92
MAX_WEEKLY_USD=3.83
# Free users split one weekly pool across the free users active this week,
# clamped per user. Free is Flash-only (its cheapest model) plus a few Pro
# messages every 30 days, counted outside the pool.
FREE_POOL_WEEKLY_USD=15
FREE_USER_WEEKLY_MIN_USD=0.03
FREE_USER_WEEKLY_MAX_USD=0.10
FREE_PRO_MESSAGES_30D=3
# A 5-hour window allows this share of the weekly budget.
FIVE_HOUR_SHARE=0.35
# Continuations of a running task may exceed the budget by this factor so a
# task isn't cut off mid-step.
CONTINUATION_HEADROOM=1.5
# One usage unit on the app's usage bars (about one Flash message).
USAGE_UNIT_USD=0.008

DEV_COUPON_CODES=
COMPOSIO_API_KEY=
ADMIN_PASSWORD=
# Secret used to HMAC-sign admin dashboard tokens. Generate with:
#   openssl rand -hex 32
# If unset, the API derives a key from ADMIN_PASSWORD (logged as a warning) —
# fine for local dev, NOT for production.
ADMIN_TOKEN_SECRET=
ADMIN_TOKEN_TTL_HOURS=12

APP_PUBLIC_URL=https://app.tryzwork.app

# Billing
ENABLE_BILLING=true
ENABLE_HOSTED_GATEWAY=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_ANNUAL=

# Monthly-normalized USD prices for MRR math (admin dashboard). Set these to
# match your Stripe price amounts. Defaults reflect the current zWork pricing.
PRO_PRICE_MONTHLY_USD=12
PRO_PRICE_ANNUAL_MONTHLY_USD=10
MAX_PRICE_MONTHLY_USD=50
MAX_PRICE_ANNUAL_MONTHLY_USD=41.67

# Email auth
ENABLE_EMAIL_AUTH=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=zWork <no-reply@tryzwork.app>
ENABLE_COUPONS=true

# Public no-login chat demo (app.tryzwork.app → POST /api/demo/chat).
# Streams from OpenRouter (Flash's cheapest model); bounded by a per-IP daily cap
# and a tower-governor burst limiter. Set DEMO_ENABLED=false to kill-switch.
DEMO_ENABLED=true
DEMO_DAILY_REQUESTS_PER_IP=50
